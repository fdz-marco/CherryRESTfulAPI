# ============================================================
#  Cherry RESTful API — Environment variables example
#
#  Instructions:
#    1. Copy this file: cp .env.example .env
#    2. Fill in every value — especially API_SECRET
#    3. Never commit .env to source control (add it to .gitignore)
#
#  Loading .env in PHP:
#    PHP does not load .env files natively. Options:
#      a) vlucas/phpdotenv (Composer): https://github.com/vlucas/phpdotenv
#         require 'vendor/autoload.php';
#         Dotenv\Dotenv::createImmutable(__DIR__)->load();
#
#      b) Server-level environment variables (recommended for production):
#         Apache:  SetEnv API_SECRET "your_secret" inside <VirtualHost>
#         Nginx:   fastcgi_param API_SECRET "your_secret"; inside location ~ \.php$
#         Docker:  environment: - API_SECRET=your_secret  in docker-compose.yml
# ============================================================

# -------- Authentication ------------------------------------
# Generate a strong random secret, e.g.:
#   openssl rand -hex 32
API_SECRET=replace_with_a_long_random_string

# -------- Application ---------------------------------------
# Environment: production | development
APP_ENV=production

# Show full exception detail in 500 responses (true = development ONLY)
APP_DEBUG=false

# Base path when API lives in a subfolder, e.g. /api  (leave empty for root)
APP_BASE_PATH=

# -------- Request limits ------------------------------------
# Maximum accepted request body size in bytes (default: 1048576 = 1 MB)
APP_MAX_INPUT_SIZE=1048576

# -------- CORS ----------------------------------------------
# Comma-separated list of allowed origins, or * to allow all
# Example: https://app.example.com,https://admin.example.com
CORS_ORIGINS=*
