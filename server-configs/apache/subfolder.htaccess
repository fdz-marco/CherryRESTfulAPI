# ============================================================
#  Cherry RESTful API — Apache .htaccess (subfolder placement)
#  Use when your API lives under a sub-path, e.g. /api/.
#
#  Instructions:
#    1. Rename this file to .htaccess
#    2. Copy it into your API sub-directory (e.g. /api/.htaccess)
#    3. Update RewriteBase to match your sub-path
#    4. Set the same sub-path via CherryRESTfulAPI::setBasePath('/api')
#
#  Requires: mod_rewrite, mod_headers, AllowOverride All
# ============================================================

# -------- HTTPS redirect (uncomment in production) ----------
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# -------- Route all requests to index.php -------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /api/        # <-- change to match your sub-path

    # Do not rewrite real files or directories
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# -------- Block access to sensitive files -------------------
<FilesMatch "^(\.env|\.git|composer\.(json|lock)|package\.json|package-lock\.json)">
    Order allow,deny
    Deny from all
</FilesMatch>

# -------- Security headers ----------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    Header always set Cache-Control "no-store"

    # Strict-Transport-Security (enable only when HTTPS is enforced)
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# -------- Disable directory listing -------------------------
Options -Indexes

# -------- Default character set -----------------------------
AddDefaultCharset UTF-8
